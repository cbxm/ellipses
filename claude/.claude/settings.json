{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "SUDO_ASKPASS": "/usr/bin/ssh-askpass"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(ts-node:*)",
      "Bash(node --loader ts-node/esm:*)",
      "Bash(npm run start)",
      "Bash(npm run worker:*)",
      "WebFetch(domain:docs.meevoapi.com)",
      "Bash(git worktree:*)",
      "Bash(npm view:*)",
      "Bash(npm start)",
      "Bash(npm run dev:*)",
      "Bash(npm test:*)",
      "mcp__context7__get-library-docs",
      "WebSearch",
      "mcp__context7__resolve-library-id",
      "WebFetch(domain:support.telnyx.com)",
      "Bash(gh issue view:*)",
      "Bash(gh api:*)",
      "Bash(git ls-tree:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "plan",
    "additionalDirectories": [
      "/home/cbxm/.claude/profiles",
      "/home/cbxm/.claude/skills",
      "/home/cbxm/src/cassie/.claude/profiles",
      "/home/cbxm/src/cassie/.claude/skills"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash /home/cbxm/.claude/nojo-statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "verbose": false,
  "terminalProgressBarEnabled": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
