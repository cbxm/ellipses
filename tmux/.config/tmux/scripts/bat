#!/bin/bash
bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null || echo 50)
status=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null || echo "Unknown")

# Only warning levels get a badge: terminal-background text (reverse) on red and
# yellow. The normal level is plain text in the terminal's own foreground. See tmux/docs.md.
if [ "$bat" -lt 20 ]; then
  c='fg=red,bg=default,reverse'
elif [ "$bat" -lt 50 ]; then
  c='fg=yellow,bg=default,reverse'
else
  c='fg=default,bg=default,noreverse'
fi

if [ "$status" = "Charging" ]; then
  icon=$'\U000f06a5'
else
  icon=$'\U000f0079'
fi

printf '#[%s] %s %s%% #[noreverse]' "$c" "$icon" "$bat"
