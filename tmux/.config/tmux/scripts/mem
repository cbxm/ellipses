#!/bin/bash
# Get RAM and swap in GB with decimal precision
read ram swap <<< $(free -b | awk '
  /Mem:/ { ram=$3/1073741824 }
  /Swap:/ { swap=$3/1073741824 }
  END { printf "%.1f %.1f", ram, swap }
')

# RAM color thresholds (for ~13GB system)
ram_int=${ram%.*}
if [ "$ram_int" -gt 11 ]; then
  c='red'
elif [ "$ram_int" -gt 8 ]; then
  c='yellow'
else
  c='green'
fi

ram_icon=$'\uf2db'
swap_icon=$'\uf1c0'

if (( $(echo "$swap > 0.1" | bc -l) )); then
  # Swap color
  swap_int=${swap%.*}
  if [ "$swap_int" -gt 40 ]; then
    sc='red'
  elif [ "$swap_int" -gt 20 ]; then
    sc='yellow'
  else
    sc='green'
  fi
  printf '#[fg=black,bg=%s] %s %s #[fg=black,bg=%s] %s %s ' "$c" "$ram_icon" "$ram" "$sc" "$swap_icon" "$swap"
else
  printf '#[fg=black,bg=%s] %s %s ' "$c" "$ram_icon" "$ram"
fi
