{
	// Place your snippets for python here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"Quick Print": {
		"prefix": "dolo",
		"body": "print($0)",
		"description": "Easy shortcut to jump inside a print statement"
	},
	"Abstract Static Method": {
		"prefix": "@abs",
		"body": [
			"@abstractstaticmethod",
			"def ${0:name}(${1:args}):",
			"    raise NotImplementedError"
		]
	},
	"debug variable": {
		"prefix": "dbv",
		"body": "print(f\"DEBUG | {${0:variable} = }\")",
		"description": "Shortcut for printing debugging variables."
	},
	"enter func": {
		"prefix": "dbe",
		"body": "print(f\"DEBUG | Entering func: `${0:func}`\")",
		"description": "Shortcut for print debugging code execution."
	}
}