# Personal info (name, email) lives in ~/.gitconfig.local
[include]
	path = ~/.gitconfig.local

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[core]
	editor = nvim
[init]
	defaultBranch = main
[alias]
	pull-all = "!find . -type d \\( -name node_modules -prune -o -name .git -prune -printf '%h\\n' \\) | xargs -P8 -I{} sh -c 'out=$(git -C \"$1\" pull --ff-only 2>&1); printf \"== %s\\n%s\\n\" \"$1\" \"$out\"' _ {}"
