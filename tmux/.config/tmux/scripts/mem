#!/bin/bash
# Get RAM and swap in GB with decimal precision
read ram swap <<< $(free -b | awk '
  /Mem:/ { ram=$3/1073741824 }
  /Swap:/ { swap=$3/1073741824 }
  END { printf "%.1f %.1f", ram, swap }
')

# RAM color thresholds (for ~13GB system). Only warning levels get a badge:
# terminal-background text (reverse) on red and yellow. The normal level is plain
# text in the terminal's own foreground. See tmux/docs.md.
ram_int=${ram%.*}
if [ "$ram_int" -gt 11 ]; then
  c='fg=red,bg=default,reverse'
elif [ "$ram_int" -gt 8 ]; then
  c='fg=yellow,bg=default,reverse'
else
  c='fg=default,bg=default,noreverse'
fi

ram_icon=$'\uf2db'
swap_icon=$'\uf1c0'

if (( $(echo "$swap > 0.1" | bc -l) )); then
  # Swap color
  swap_int=${swap%.*}
  if [ "$swap_int" -gt 40 ]; then
    sc='fg=red,bg=default,reverse'
  elif [ "$swap_int" -gt 20 ]; then
    sc='fg=yellow,bg=default,reverse'
  else
    sc='fg=default,bg=default,noreverse'
  fi
  printf '#[%s] %s %s #[%s] %s %s #[noreverse]' "$c" "$ram_icon" "$ram" "$sc" "$swap_icon" "$swap"
else
  printf '#[%s] %s %s #[noreverse]' "$c" "$ram_icon" "$ram"
fi
