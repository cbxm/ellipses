{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "SUDO_ASKPASS": "/usr/bin/ssh-askpass"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(ts-node:*)",
      "Bash(node --loader ts-node/esm:*)",
      "Bash(npm run start)",
      "Bash(npm run worker:*)",
      "WebFetch(domain:docs.meevoapi.com)",
      "Bash(git worktree:*)",
      "Bash(npm view:*)",
      "Bash(npm start)",
      "Bash(npm run dev:*)",
      "Bash(npm test:*)",
      "mcp__context7__get-library-docs",
      "WebSearch",
      "mcp__context7__resolve-library-id",
      "WebFetch(domain:support.telnyx.com)",
      "Bash(gh issue view:*)",
      "Bash(gh api:*)",
      "Bash(git ls-tree:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "plan",
    "additionalDirectories": [
      "/home/cbxm/.claude/profiles",
      "/home/cbxm/.claude/skills",
      "/home/cbxm/src/cassie/.claude/profiles",
      "/home/cbxm/src/cassie/.claude/skills"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/cbxm/src/nojo/build/src/cli/features/claude-code/hooks/config/nested-install-warning.js"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/cbxm/src/nojo/build/src/cli/features/claude-code/hooks/config/context-usage-warning.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/cbxm/src/nojo/build/src/cli/features/claude-code/hooks/config/notify-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/cbxm/src/nojo/build/src/cli/features/claude-code/hooks/config/slash-command-intercept.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/cbxm/.claude/nojo-statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "terminalProgressBarEnabled": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
